+/// The routing-detail row cap (task 162/163): STRATA_QWEN35_ROUTING_DETAIL_MAX overrides the historical
+/// 2248-row (281-layer) bound.  It must be a plain decimal integer in [1, 81920]; unset, empty, sign/space,
+/// trailing junk, zero, or any value beyond 81920 (which also rejects every 64-bit overflow) keeps 2248,
+/// so the default path is unchanged.  Read once (cached); only the diagnostic writer consults it.
+uint64_t routing_detail_max_rows() {
+    static const uint64_t v = [] {
+        constexpr uint64_t kFallback = (uint64_t) 2248;
+        constexpr uint64_t kHardMax = (uint64_t) 81920;
+        const char* e = std::getenv("STRATA_QWEN35_ROUTING_DETAIL_MAX");
+        if (e == nullptr) return kFallback;
+        uint64_t acc = 0;
+        for (const char* p = e; *p != '\0'; ++p) {
+            if (*p < '0' || *p > '9') return kFallback;             // no sign, space or trailing junk
+            const uint64_t d = (uint64_t) (*p - '0');
+            if (acc > (kHardMax - d) / 10) return kFallback;        // beyond 81920 (covers uint64 overflow)
+            acc = acc * 10 + d;
+        }
+        return acc == 0 ? kFallback : acc;                          // zero rejected
+    }();
+    return v;
+}
